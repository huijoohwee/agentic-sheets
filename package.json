{
  "name": "agentic-sheets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "exports": {
    ".": "./sheets/core.mjs",
    "./storage": "./sheets/storage.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:sheets": "npm run dev",
    "build:sheets": "node scripts/build-sheets.mjs --write",
