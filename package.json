    "check": "npm run check:sheets",
    "test": "npm run check",
    "setup": "agentic-os setup",
    "doctor": "agentic-os doctor",
    "lane": "agentic-os start",
    "land": "agentic-os land"
  },
  "devDependencies": {
    "agentic-os": "github:huijoohwee/agentic-os#d3430c8da71b0128b644040bfd1ef32d9f36c50e"
  }
