{
  "name": "agentic-sheets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "exports": {
    ".": "./sheets/core.mjs",
    "./storage": "./sheets/storage.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:sheets": "npm run dev",
    "build:sheets": "node scripts/build-sheets.mjs --write",
    "check:sheets": "node --test && node scripts/build-sheets.mjs --check",
    "check:annotation-targets": "node scripts/check-annotation-targets.mjs",
    "check": "npm run check:sheets && npm run check:annotation-targets",
    "test": "npm run check",
    "setup": "agentic-os setup",
    "doctor": "agentic-os doctor",
    "lane": "agentic-os start",
    "land": "agentic-os land",
    "successor": "agentic-os successor",
    "release:common": "agentic-os release-common",
    "sync:canonical": "agentic-os canonical-sync"
  },
  "devDependencies": {
    "agentic-design-system": "github:huijoohwee/agentic-design-system#8693ed5ac9a78086bd26cf412e2e734afebb24cb",
    "agentic-gateway": "https://codeload.github.com/huijoohwee/agentic-gateway/tar.gz/cdb000925729a729732206a32de36e6bc7db011c",
    "agentic-os": "https://codeload.github.com/huijoohwee/agentic-os/tar.gz/9e171b490b158ecbc5e8e024e9bccc409fd756b0",
    "playwright": "1.62.1"
  }
}
